  "session_and_cookie_contract": {
    "session_keys": {
      "admin_id": "INTEGER (e.g. 2)",
      "full_name": "STRING (e.g. 'Ramesh (SVGP Admin)')",
      "username": "STRING (e.g. 'ramesh_svgp')",
      "email": "STRING (e.g. 'ramesh@svgp.edu')",
      "role": "STRING ('campus_admin' or 'master_admin')",
      "admin_logged_in": "BOOLEAN (true)",
      "reunite_admin_auth": "BOOLEAN (true)",
      "admin_campus_id": "INTEGER or NULL (e.g. 1 for SVGP, NULL for Master Admin)",
      "admin_campus_name": "STRING (e.g. 'Sri Venkateswara Govt Polytechnic')",
      "admin_campus_code": "STRING (e.g. 'SVGP')"
    },
    "cookie": {
      "name": "reunite_admin_session",
      "format": "Base64 encoded JSON string: {\"admin_id\":2,\"username\":\"ramesh_svgp\",\"role\":\"campus_admin\",\"campus_id\":1,\"ts\":1793090000}",
      "attributes": "path=/; httponly; samesite=Lax; max-age=28800 (8 hours)"
    }
  },
  "database_schema_reference": {
    "admins_table": {
      "name": "admins",
      "columns": [
        "admin_id INT(11) AUTO_INCREMENT PRIMARY KEY",
        "username VARCHAR(50) UNIQUE NOT NULL",
        "full_name VARCHAR(100) NOT NULL",
        "email VARCHAR(100) UNIQUE NOT NULL",
        "password_hash VARCHAR(255) NOT NULL",
        "role ENUM('master_admin','campus_admin','superadmin','admin','moderator') DEFAULT 'campus_admin'",
        "campus_id INT(11) NULL DEFAULT NULL (Foreign key referencing campuses.id)",
        "status ENUM('active','suspended') DEFAULT 'active'",
        "last_login DATETIME NULL",
        "created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP",
        "updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP"
      ]
    },
    "campuses_table": {
      "name": "campuses",
      "columns": [
        "id INT(11) AUTO_INCREMENT PRIMARY KEY",
        "name VARCHAR(150) NOT NULL",
        "code VARCHAR(50) UNIQUE NOT NULL",
        "status ENUM('active','inactive') DEFAULT 'active'",
        "created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP",
        "updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP"
      ]
    },
    "admin_audit_logs_table": {
      "name": "admin_audit_logs",
      "columns": [
        "id INT(11) AUTO_INCREMENT PRIMARY KEY",
        "admin_id INT(11) NOT NULL",
        "action VARCHAR(100) NOT NULL",
        "target_type VARCHAR(50) NULL",
        "target_id INT(11) NULL",
        "campus_id INT(11) NULL",
        "details TEXT NULL",
        "ip_address VARCHAR(45) NULL",
        "created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP"
      ]
    }
  }
}
