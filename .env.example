# AI Microservice internal authorization shared secret
AI_SECRET_KEY=reunite_ai_secret_token_2026_kolkata

# ── 3. Claim & Handover Lifecycle v2 Configuration ────────────────────────────
# Modes: 'off' (decommissioned), 'testers' (admin + tester cohort), 'on' (public)
