# ==============================================================================
# Reunite Platform — Environment Configuration Template
# Copy this file to .env and fill in your production values
# ==============================================================================

# ── 1. MySQL Relational Database Configuration ────────────────────────────────
# In production (e.g. InfinityFree, Hostinger, cPanel, Railway, AWS RDS, PlanetScale):
# Replace with your production MySQL database host, username, password, and db name.
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=lost_connect_db
DB_PORT=3306

# ── 2. Security & Data Encryption ─────────────────────────────────────────────
# 32+ character key used for encrypting student emails, phone numbers, and tokens
APP_ENC_KEY=reunite_secret_encryption_key_2024

# ── 3. Python Flask AI Microservice URL ───────────────────────────────────────
# Local development: http://127.0.0.1:5000
# Cloud production (e.g. Render.com): https://reunite-ai-backend.onrender.com
FLASK_BACKEND_URL=http://127.0.0.1:5000

# ── 4. AI Vision & Multimodal API Keys ────────────────────────────────────────
# Google Gemini API Key (Get from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Secondary Gemini keys for automatic failover / rate limit redundancy
# GEMINI_API_KEY_2=your_second_gemini_key
# GEMINI_API_KEY_3=your_third_gemini_key

# Mistral AI Key (Get from: https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=your_mistral_api_key_here

# ── 5. Email Gateway (Brevo API / SMTP) ───────────────────────────────────────
# Used for student registration OTPs and password reset links
BREVO_API_KEY=
BREVO_SENDER_EMAIL=charante153624@gmail.com
BREVO_SENDER_NAME=REUNITE TEAM
