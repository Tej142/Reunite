# ==============================================================================
# Reunite Production Platform — Complete Credentials & Configurations (.env.example)
# ==============================================================================

# ── 1. MySQL Relational Database Configuration ────────────────────────────────
# In production (e.g. InfinityFree MySQL, Remote Cloud DB):
# Enter your MySQL Hostname, Database Name, Username, and Password.
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=lost_connect_db
DB_PORT=3306

# ── 2. Security & Data Encryption ─────────────────────────────────────────────
# 32+ character secret key for encrypting emails, phones, and tokens
APP_ENC_KEY=reunite_secret_encryption_key_2024
ADMIN_MASTER_KEY=admin@reunite2024

# ── 3. Python Flask AI Microservice URL (Cloud Production) ────────────────────
FLASK_BACKEND_URL=https://reunite-ai-backend.onrender.com
FLASK_AI_URL=https://reunite-ai-backend.onrender.com

# ── 4. Multimodal AI API Keys (Google Gemini + Mistral AI) ────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_key
GEMINI_API_KEY_3=your_third_gemini_key

MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_API_KEY_2=your_second_mistral_key
MISTRAL_API_KEY_3=your_third_mistral_key

# ── 5. Email Delivery & OTP Gateway (SMTP / Resend / Brevo) ───────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=REUNITE TEAM

RESEND_API_KEY=your_resend_api_key_here
RESEND_SENDER_EMAIL=onboarding@resend.dev
RESEND_SENDER_NAME=REUNITE TEAM

BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=charante153624@gmail.com
BREVO_SENDER_NAME=REUNITE TEAM
