# Reunite AI Module Environment Configuration
# Add your Gemini and Mistral API keys below:

# 1. Google Gemini API Key (Get from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Extra Gemini keys for automatic failover / rate limit redundancy
# GEMINI_API_KEY_2=your_second_key
# GEMINI_API_KEY_3=your_third_key

# 2. Mistral API Key (Get from: https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=your_mistral_api_key_here
